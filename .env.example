# SpiceHub environment variables — copy to .env and fill in values

# Unified Import Engine (v2)
VITE_USE_V2_IMPORT=true
VITE_API_BASE=https://your-render-service.onrender.com

# Backend (set in Render dashboard, not here)
ENABLE_V2_IMPORT=true
IG_COOKIES_JSON_B64=<base64 of cookies.json>
GEMINI_API_KEY=<your key>

# ── AI keys (ALL server-only — never use VITE_ prefix for secrets) ──────────
# Gemini (structuring + vision): used by /api/structure and /api/vision
GOOGLE_GENERATIVE_AI_API_KEY=<your key>
# Mistral (vision tier 2, optional): used by /api/vision?provider=mistral
# MISTRAL_API_KEY=<your key>

# ── Client-safe config (not secrets) ────────────────────────────────────────
# Override vision model name (not a secret, just a model identifier)
# VITE_GEMINI_VISION_MODEL=gemini-2.0-flash-lite
# VITE_MISTRAL_MODEL=pixtral-12b-latest

# Tier 3: on-device Tesseract OCR — no key, always available (offline fallback)

# ── Home Group (Supabase relay) ─────────────────────────────────────────────
# Client-safe config (not secrets — Supabase anon key is designed to be public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_HOME_GROUP_ENABLED=true
VITE_FRIENDS_ENABLED=true

